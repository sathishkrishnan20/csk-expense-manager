# Address of your deployed backup server (see server/README.md). Restart Expo after changing it: npx expo start -c
EXPO_PUBLIC_BACKUP_URL=

# Your own IBJA-API deployment on Vercel, no trailing slash, and the key that matches APP_API_KEY there. Leave both empty to use
# the open public instance (the key is never sent to it). The key is bundled into the app, so use a key made just for this app.
# Restart Expo after changing them: npx expo start -c
EXPO_PUBLIC_IBJA_BASE_URL=
EXPO_PUBLIC_IBJA_API_KEY=
