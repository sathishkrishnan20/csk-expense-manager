{
  "expo": {
    "name": "Expense Manager",
    "slug": "ai-expense-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sathish.aiexpensemanager",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Expense Manager connects to an Ollama server on your network to categorise transactions, if you choose Ollama.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Bank statement (PDF)",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.adobe.pdf"
            ]
          },
          {
            "CFBundleTypeName": "Bank statement (Excel)",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.microsoft.excel.xls",
              "org.openxmlformats.spreadsheetml.sheet"
            ]
          },
          {
            "CFBundleTypeName": "Bank statement (CSV)",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.comma-separated-values-text"
            ]
          }
        ]
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sharing"
    ],
    "platforms": [
      "ios",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "expensemanager"
  }
}
