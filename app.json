{
  "expo": {
    "name": "Expense Manager",
    "slug": "ai-expense-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sathish.aiexpensemanager",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Expense Manager connects to an Ollama server on your network to categorise transactions, if you choose Ollama."
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sharing"
    ],
    "platforms": [
      "ios",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "expensemanager"
  }
}
